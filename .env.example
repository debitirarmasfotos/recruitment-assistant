# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: preferred model
OPENAI_MODEL=gpt-4o

# AAMAD runtime target (default for this course)
AAMAD_TARGET_RUNTIME=crewai

# Application Configuration
APP_NAME=Recruitment Assistant
APP_ENV=development

# CrewAI Configuration
CREWAI_TELEMETRY_OPT_OUT=true

# CrewAI tracing: set true to send run traces to app.crewai.com (requires
# `crewai login`). Default false so offline/local runs and tests make no
# network/auth calls.
CREWAI_TRACING_ENABLED=false

# Logging: level for the app logger (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
